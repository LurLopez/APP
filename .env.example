PORT=3000

# Secreto para firmar las cookies de sesión (JWT). Cámbialo en producción.
JWT_SECRET=genera-una-clave-larga-aleatoria

# Puedes usar DATABASE_URL o las variables individuales de PostgreSQL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cifra
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cifra
DB_USER=postgres
DB_PASSWORD=postgres

# IA: qué API usar. deepseek = API directa de DeepSeek · opencode = suscripción OpenCode Go (pruebas)
# Solo cambia esta línea: las dos claves se ponen más abajo.
AI_PROVIDER=deepseek

# Tamaño máximo de la respuesta del modelo (tokens). El informe final del analista
# supera 8000: usa al menos 16000 o el modelo devuelve respuesta vacía.
AI_MAX_TOKENS=16000
# Timeout por llamada al modelo (ms). Si la API tarda más, se corta con error claro.
AI_REQUEST_TIMEOUT_MS=180000

# Clave de la API directa de DeepSeek. Sin ella el análisis no funciona (error visible).
DEEPSEEK_API_KEY=
# Opcional: AI_MODEL=deepseek-chat

# Clave de OpenCode Go (https://opencode.ai/auth → suscripción Go → API key).
OPENCODE_GO_API_KEY=
# Opcional: OPENCODE_GO_MODEL=deepseek-v4-flash

# Correo para el código de verificación al registrarse.
# Sin SMTP configurado, en desarrollo el código se imprime por consola.
# Con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false y
# SMTP_PASS debe ser una contraseña de aplicación (https://myaccount.google.com/apppasswords).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Cifra <no-reply@cifra.app>

# PRUEBAS: redirige todos los correos salientes a esta dirección.
# Déjalo vacío para enviar a la dirección real del usuario.
MAIL_TO_OVERRIDE=
