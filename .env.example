PORT=3000

# Entorno de ejecución. En producción define NODE_ENV=production (activa las
# cookies de sesión con flag Secure y el modo producción de Express).
# En local puede omitirse (se comporta como development).
# NODE_ENV=production

# URL pública del sitio (SEO): se usa en canonicals, Open Graph, sitemap y llms.txt.
# En producción: https://tudominio.com (sin barra final).
PUBLIC_SITE_URL=http://localhost:3000

# Secreto para firmar las cookies de sesión (JWT). Cámbialo en producción.
JWT_SECRET=genera-una-clave-larga-aleatoria

# Google OAuth 2.0 (Registro e Inicio de sesión con Google)
# Consíguelos en Google Cloud Console (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional en desarrollo (por defecto http://localhost:PORT/api/auth/google/callback):
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Puedes usar DATABASE_URL o las variables individuales de PostgreSQL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cifra
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cifra
DB_USER=postgres
DB_PASSWORD=postgres

# IA: qué API usar.
#   deepseek = API directa de DeepSeek (nube)
#   opencode = suscripción OpenCode Go (pruebas)
#   local / ollama = modelo local (Ollama, LM Studio, etc.)
#   mock = heurística de prueba sin coste (desarrollo básico)
# Solo cambia esta línea para alternar de modelo:
AI_PROVIDER=deepseek

# Tamaño máximo de la respuesta del modelo (tokens). El informe final del analista
# supera 8000: usa al menos 16000 o el modelo devuelve respuesta vacía.
AI_MAX_TOKENS=16000
# Timeout por llamada al modelo (ms). Si la API tarda más, se corta con error claro.
AI_REQUEST_TIMEOUT_MS=180000
# Opcional: carpeta del log acumulativo de análisis (por defecto ./logs; archivo analisis.log).
# ANALYSIS_LOG_DIR=

# Clave de la API directa de DeepSeek. Sin ella el análisis no funciona (error visible).
DEEPSEEK_API_KEY=
# Modelo de DeepSeek: deepseek-flash = DeepSeek-V4.1-Flash (recomendado);
# deepseek-v4-pro para el Pro. El alias antiguo deepseek-chat está retirado.
AI_MODEL=deepseek-flash
# Razonamiento del modelo: disabled (rápido, por defecto) | enabled (más lento y caro, más calidad).
AI_THINKING=disabled

# Clave de OpenCode Go (https://opencode.ai/auth → suscripción Go → API key).
OPENCODE_GO_API_KEY=
# Opcional: OPENCODE_GO_MODEL=deepseek-v4-flash
# Opcional: identificador del cliente que OpenCode Go pide en cada petición.
# AI_CLIENT_USER_AGENT=Cifra-FinancialAnalyzer/0.1

# Modelo local (Ollama, LM Studio, LocalAI, vLLM, etc.)
# Para activarlo: AI_PROVIDER=local (o AI_PROVIDER=ollama)
LOCAL_AI_URL=http://localhost:11434/v1/chat/completions
LOCAL_AI_MODEL=hf.co/empero-ai/Qwen3.8-9B-GGUF:Q4_K_M
# Opcional: API Key si tu servidor local la requiere (Ollama no la necesita):
# LOCAL_AI_API_KEY=
# Opcional: timeout específico para el modelo local (en ms; por defecto toma AI_REQUEST_TIMEOUT_MS o 300000):
# LOCAL_AI_REQUEST_TIMEOUT_MS=300000

# Correo para el código de verificación al registrarse.
# Sin SMTP configurado, en desarrollo el código se imprime por consola.
# Con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false y
# SMTP_PASS debe ser una contraseña de aplicación (https://myaccount.google.com/apppasswords).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Cifra <no-reply@cifraresearch.com>

# PRUEBAS: redirige todos los correos salientes a esta dirección.
# Déjalo vacío para enviar a la dirección real del usuario.
MAIL_TO_OVERRIDE=

# Límite diario de análisis nuevos con IA por usuario registrado.
# Leer/abrir análisis ya existentes no consume cupo. Los administradores no tienen límite.
DAILY_AI_ANALYSES_LIMIT=3

# Usuario Administrador del sistema (credenciales secretas).
# Genera un usuario y una contraseña aleatorios y guárdalos SOLO en el .env
# local y en el del servidor. No se suben nunca a GitHub.
# El administrador es SIEMPRE el usuario configurado aquí: cualquier otra
# cuenta (incluidas las creadas con Google) conserva el rol de usuario normal.
ADMIN_USERNAME=cambia-este-usuario-aleatorio
ADMIN_PASSWORD=cambia-esta-contrasena-aleatoria
ADMIN_EMAIL=admin@cifra.local

